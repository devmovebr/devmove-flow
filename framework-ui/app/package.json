{
  "name": "devmove-painel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "dev:mock": "tsx dev/mock-consultto.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server.mjs",
    "build:cli": "esbuild src/runner/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=../../framework/tools/qa.mjs && cp ../../framework/tools/qa.mjs ../../demo/tools/qa.mjs",
    "start": "node --no-warnings=ExperimentalWarning dist/server.mjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "fastify": "^5.12.7",
    "jsonpath-plus": "^11.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
